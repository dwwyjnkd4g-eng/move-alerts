# Same keys as your GitHub secrets
ANTHROPIC_API_KEY=
FINNHUB_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# From my.telegram.org -> API development tools (for the live squawk listener)
TG_API_ID=
TG_API_HASH=

# Squawk channels to listen to (public channel usernames, comma-separated)
SQUAWK_CHANNELS=financialjuice,WalterBloomberg,TreeNewsFeed

# On the server the listener reads the Telegram channels live, so the polled feed skips them
NEWS_SKIP_TELEGRAM=1

# 3 = top-tier news only, 2 = also relevant (default)
NEWS_MIN_IMPORTANCE=2

# 30-min market snapshot: skipped during these UK hours (start-end). Empty = send all night.
SNAPSHOT_QUIET=23-06

# Gradient-boosted trees in the quant ensemble (1 = on). The Nov 2026 backtest showed they help.
QUANT_GBM=1
# Only show a trade plan when its edge score is at least this (backtest: only 75+ made money)
MIN_PLAN_SCORE=75
# Risk per trade for position sizing (fraction of capital) and minimum reward/risk for a plan
RISK_PER_TRADE=0.005
MIN_RR=0.33

# 1 = every relevant squawk headline sent instantly; 0 = 5-minute digest
SQUAWK_INSTANT=1

# Paper-trading ledger: notional capital used to size paper trades (GBP)
PAPER_CAPITAL=100000
# A stock already alerted today gets a short follow-on line when it moves this much further
EXTENSION_STEP=0.05
