# Same keys as your GitHub secrets
ANTHROPIC_API_KEY=
FINNHUB_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# From my.telegram.org -> API development tools (for the live squawk listener)
TG_API_ID=
TG_API_HASH=

# Squawk channels to listen to (public channel usernames, comma-separated)
SQUAWK_CHANNELS=financialjuice,WalterBloomberg,TreeNewsFeed

# On the server the listener reads the Telegram channels live, so the polled feed skips them
NEWS_SKIP_TELEGRAM=1

# 3 = top-tier news only, 2 = also relevant (default)
NEWS_MIN_IMPORTANCE=2

# 30-min market snapshot: skipped during these UK hours (start-end). Empty = send all night.
SNAPSHOT_QUIET=23-06
